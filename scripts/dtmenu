#!/bin/bash
#============================================================================
#  dtmenu - Menu de configuracion de ccldproxy
#  Ejecutar como root:  dtmenu
#============================================================================

CCLD_BIN="/usr/bin/ccldproxy"
CONF_DIR="/etc/ccldproxy"
CONF_FILE="$CONF_DIR/config"
SERVICE="ccldproxy"

bold()   { echo -e "\033[1m$1\033[0m"; }
green()  { echo -e "\033[1;32m$1\033[0m"; }
yellow() { echo -e "\033[1;33m$1\033[0m"; }
red()    { echo -e "\033[1;31m$1\033[0m"; }
cyn()    { echo -e "\033[1;36m$1\033[0m"; }

[[ "$(id -u)" != "0" ]] && { red "Requiere ejecutar como root."; exit 1; }

# --- Cargar config ---------------------------------------------------------
load_conf() {
  TOKEN="$(grep '^TOKEN=' "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
  PORT="$(grep   '^PORT='   "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
  MAXIP="$(grep  '^MAXIP='  "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
  QUIET="$(grep  '^QUIET='  "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
  TOKEN="${TOKEN:-}"
  PORT="${PORT:-80}"
  MAXIP="${MAXIP:-0}"
  QUIET="${QUIET:-no}"
}
save_conf() {
  mkdir -p "$CONF_DIR"
  cat > "$CONF_FILE" <<EOF
TOKEN=$TOKEN
PORT=$PORT
MAXIP=$MAXIP
QUIET=$QUIET
EOF
  chmod 600 "$CONF_FILE"
}

# --- Estado del servicio ---------------------------------------------------
status() {
  if pgrep -f "^$CCLD_BIN " >/dev/null 2>&1; then
    green "[ATIVO]"
  else
    red "[PARADO]"
  fi
}

# --- Arrancar / reiniciar --------------------------------------------------
has_systemd() { command -v systemctl >/dev/null 2>&1; }

run_cmd() {
  local q=""
  [[ "$QUIET" = "yes" ]] && q=" --quiet"
  echo "$CCLD_BIN --token $TOKEN --port $PORT --max-per-ip $MAXIP$q"
}

start_service() {
  local cmd; cmd="$(run_cmd)"
  # detener instancias previas
  pkill -f "^$CCLD_BIN " 2>/dev/null
  if has_systemd && systemctl daemon-reload >/dev/null 2>&1; then
    cat > /etc/systemd/system/ccldproxy.service <<EOF
[Unit]
Description=ccldproxy - servidor de tuneles
After=network.target

[Service]
Type=simple
ExecStart=$cmd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable "$SERVICE" >/dev/null 2>&1
    systemctl restart "$SERVICE"
    green "Servicio $SERVICE reiniciado."
  else
    # sin systemd: lanzar en background
    mkdir -p /var/log/ccldproxy
    nohup $cmd >> /var/log/ccldproxy/ccldproxy.log 2>&1 &
    green "Servicio $SERVICE arrancado (sin systemd). Log: /var/log/ccldproxy/ccldproxy.log"
  fi
}

stop_service() {
  if has_systemd && systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
    systemctl stop "$SERVICE"
    green "Servicio $SERVICE detenido."
  else
    pkill -f "^$CCLD_BIN " 2>/dev/null
    green "Servicio detenido."
  fi
}

# --- Menu ------------------------------------------------------------------
while true; do
  clear
  echo "============================================================"
  bold  "            MENU CCLDPROXY $(status)"
  echo "============================================================"
  echo "  [1]  Ver configuracion"
  echo "  [2]  Cambiar token"
  echo "  [3]  Cambiar puerto"
  echo "  [4]  Limite de conexiones por IP (0 = sin limite)"
  echo "  [5]  Modo silencioso (on/off)"
  echo "  [6]  Arrancar / reiniciar servicio"
  echo "  [7]  Detener servicio"
  echo "  [8]  Ver logs"
  echo "  [9]  Gestionar usuarios SSH"
  echo "  [00] Salir"
  echo "============================================================"
  read -rp "Opcion: " opt
  case "$opt" in
    1)
      clear
      load_conf
      echo "=== Configuracion ==="
      echo "Token:  ${TOKEN:-(sin definir)}"
      echo "Puerto: $PORT"
      echo "Max/IP: $MAXIP"
      echo "Quiet:  $QUIET"
      read -rp "Enter para continuar..." x ;;
    2)
      clear
      load_conf
      echo "=== Cambiar token ==="
      read -rp "Nuevo token: " TOKEN
      if [[ -z "$TOKEN" ]]; then
        red "El token no puede estar vacio. No se guardo."
      else
        save_conf; start_service
      fi
      read -rp "Enter..." x ;;
    3)
      clear
      load_conf
      echo "=== Cambiar puerto ==="
      read -rp "Nuevo puerto: " PORT
      if ! [[ "$PORT" =~ ^[0-9]+$ ]] || [[ "$PORT" -lt 1 || "$PORT" -gt 65535 ]]; then
        red "Puerto invalido. No se guardo."
        PORT="$(grep '^PORT=' "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
      else
        save_conf; start_service
      fi
      read -rp "Enter..." x ;;
    4)
      clear
      load_conf
      echo "=== Limite por IP ==="
      read -rp "Max conexiones por IP (0=sin limite): " MAXIP
      if ! [[ "$MAXIP" =~ ^[0-9]+$ ]]; then
        red "Valor invalido. No se guardo."
        MAXIP="$(grep '^MAXIP=' "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
      else
        save_conf; start_service
      fi
      read -rp "Enter..." x ;;
    5)
      clear
      load_conf
      [ "$QUIET" = "yes" ] && QUIET="no" || QUIET="yes"
      save_conf; start_service
      echo "Modo silencioso: $QUIET"
      read -rp "Enter..." x ;;
    6)
      clear
      load_conf; start_service
      read -rp "Enter..." x ;;
    7)
      clear
      stop_service
      read -rp "Enter..." x ;;
    8)
      clear
      echo "=== Logs ==="
      if has_systemd && systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        journalctl -u "$SERVICE" -n 30 --no-pager
      else
        tail -n 30 /var/log/ccldproxy/ccldproxy.log 2>/dev/null || echo "(sin logs aun)"
      fi
      read -rp "Enter..." x ;;
    9)
      clear
      echo "=== Gestion de usuarios SSH ==="
      echo "  [1] Crear usuario"
      echo "  [2] Listar usuarios"
      echo "  [3] Borrar usuario"
      echo "  [4] Cambiar password"
      echo "  [5] Cambiar nombre"
      echo "  [6] Cambiar fecha de expiracion"
      echo "  [0] Volver"
      read -rp "Opcion: " uopt
      case "$uopt" in
        1) bash /usr/bin/user.sh crear ;;
        2) bash /usr/bin/user.sh listar ;;
        3) bash /usr/bin/user.sh borrar ;;
        4) bash /usr/bin/user.sh pass ;;
        5) bash /usr/bin/user.sh nombre ;;
        6) bash /usr/bin/user.sh vence ;;
        *) ;;
      esac
      read -rp "Enter..." x ;;
    00)
      green "Saindo..."; exit 0 ;;
    *) red "Opcion invalida." ;;
  esac
done
