#!/bin/bash
#============================================================================
#  dtmenu - Menu de configuracion de ccldproxy
#  Ejecutar como root:  dtmenu
#============================================================================

CCLD_BIN="/usr/bin/ccldproxy"
CONF_DIR="/etc/ccldproxy"
CONF_FILE="$CONF_DIR/config"
SERVICE="ccldproxy"

bold()   { echo -e "\033[1m$1\033[0m"; }
green()  { echo -e "\033[1;32m$1\033[0m"; }
yellow() { echo -e "\033[1;33m$1\033[0m"; }
red()    { echo -e "\033[1;31m$1\033[0m"; }
cyn()    { echo -e "\033[1;36m$1\033[0m"; }

[[ "$(id -u)" != "0" ]] && { red "Requiere ejecutar como root."; exit 1; }

# --- Cargar config ---------------------------------------------------------
load_conf() {
  TOKEN="$(grep '^TOKEN=' "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
  PORT="$(grep   '^PORT='   "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
  MAXIP="$(grep  '^MAXIP='  "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
  QUIET="$(grep  '^QUIET='  "$CONF_FILE" 2>/dev/null | cut -d= -f2)"
  TOKEN="${TOKEN:-}"
  PORT="${PORT:-80}"
  MAXIP="${MAXIP:-0}"
  QUIET="${QUIET:-no}"
}
save_conf() {
  mkdir -p "$CONF_DIR"
  cat > "$CONF_FILE" <<EOF
TOKEN=$TOKEN
PORT=$PORT
MAXIP=$MAXIP
QUIET=$QUIET
EOF
  chmod 600 "$CONF_FILE"
}

# --- Estado del servicio ---------------------------------------------------
status() {
  if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
    green "[ATIVO]"
  else
    red "[PARADO]"
  fi
}

# --- Arrancar / reiniciar --------------------------------------------------
start_service() {
  # regenerar unidad systemd
  cat > /etc/systemd/system/ccldproxy.service <<EOF
[Unit]
Description=ccldproxy - servidor de tuneles
After=network.target

[Service]
Type=simple
ExecStart=$CCLD_BIN --token $TOKEN --port $PORT --max-per-ip $MAXIP $([ "$QUIET" = "yes" ] && echo --quiet)
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null 2>&1
  systemctl restart "$SERVICE"
  green "Servicio $SERVICE reiniciado."
}

# --- Menu ------------------------------------------------------------------
while true; do
  clear
  echo "============================================================"
  bold  "            MENU CCLDPROXY $(status)"
  echo "============================================================"
  echo "  [1]  Ver configuracion"
  echo "  [2]  Cambiar token"
  echo "  [3]  Cambiar puerto"
  echo "  [4]  Limite de conexiones por IP (0 = sin limite)"
  echo "  [5]  Modo silencioso (on/off)"
  echo "  [6]  Arrancar / reiniciar servicio"
  echo "  [7]  Detener servicio"
  echo "  [8]  Ver logs"
  echo "  [9]  Gestionar usuarios SSH"
  echo "  [00] Salir"
  echo "============================================================"
  read -rp "Opcion: " opt
  case "$opt" in
    1)
      load_conf
      echo "Token:  ${TOKEN:-(sin definir)}"
      echo "Puerto: $PORT"
      echo "Max/IP: $MAXIP"
      echo "Quiet:  $QUIET"
      read -rp "Enter para continuar..." x ;;
    2)
      load_conf; read -rp "Nuevo token: " TOKEN; save_conf; start_service ;;
    3)
      load_conf; read -rp "Nuevo puerto: " PORT; save_conf; start_service ;;
    4)
      load_conf; read -rp "Max conexiones por IP (0=sin limite): " MAXIP; save_conf; start_service ;;
    5)
      load_conf; [ "$QUIET" = "yes" ] && QUIET="no" || QUIET="yes"; save_conf; start_service ;;
    6) load_conf; start_service ;;
    7)
      systemctl stop "$SERVICE"; green "Servicio detenido." ;;
    8)
      journalctl -u "$SERVICE" -n 30 --no-pager; read -rp "Enter..." x ;;
    9)
      bash /usr/bin/user.sh; read -rp "Enter..." x ;;
    00)
      green "Saindo..."; exit 0 ;;
    *) red "Opcion invalida." ;;
  esac
done
